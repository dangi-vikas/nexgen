# Database
DB_HOST=localhost
DB_PORT=1433
DB_USERNAME=sa
DB_PASSWORD=CHANGE_ME
MSSQL_SA_PASSWORD=CHANGE_ME
MSSQL_PORT=1433

# Service DB names
USER_DB_NAME=userdb
PRODUCT_DB_NAME=productdb
INVENTORY_DB_NAME=inventorydb
CART_DB_NAME=cartdb
ORDER_DB_NAME=orderdb

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Kafka
KAFKA_HOST=localhost
KAFKA_PORT=9092
KAFKA_URL=localhost:9092
ZOOKEEPER_PORT=2181
KAFKA_UI_PORT=8080

# JWT
JWT_SECRET=CHANGE_ME_MIN_32_CHARS_LONG_SECRET_KEY
JWT_ISSUER=nexgen-user-service
JWT_AUDIENCE=nexgen-api
JWT_ACCESS_TTL_MS=900000
JWT_REFRESH_TTL_MS=604800000

# Admin bootstrap: creates this administrator once at startup if it does not exist.
# Blank by default so nothing is provisioned implicitly; set both to use it.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Kong
KONG_PROXY_PORT=8000
KONG_ADMIN_PORT=8001
KONG_PG_PASSWORD=CHANGE_ME
# Used by kong-automation/*.sh (defaults derive from the values above).
# Kong proxies to the Spring services running on the host:
# KONG_SERVICE_HOST=host.docker.internal
# Browser origin allowed by the gateway CORS plugin (never `*` with credentials):
# WEB_ORIGIN=http://localhost:3000

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# Service ports
USER_SERVICE_PORT=8081
PRODUCT_SERVICE_PORT=8083
INVENTORY_SERVICE_PORT=8082
CART_SERVICE_PORT=8086
ORDER_SERVICE_PORT=8084

# Payment (free, offline simulator: declines totals whose cents are .99)
PAYMENT_DB_NAME=paymentdb
PAYMENT_SERVICE_PORT=8085

# Notifications + Mailpit (free, offline SMTP sink: UI at :8025)
NOTIFICATION_DB_NAME=notificationdb
NOTIFICATION_SERVICE_PORT=8087
SMTP_HOST=localhost
SMTP_PORT=1025
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
